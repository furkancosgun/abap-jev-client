{
  "name": "abap-jev-client",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && abap_transpile abaplint-transpiler.json",
    "run": "npm run build && node scripts/run.mjs",
    "test": "npm run lint && npm run run",
    "lint": "abaplint",
    "lint:fix": "abaplint --fix",
    "fix": "abaplint --fix",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@abaplint/cli": "latest",
    "@abaplint/runtime": "latest",
    "@abaplint/transpiler-cli": "latest",
    "abap-kit": "latest"
  }
}